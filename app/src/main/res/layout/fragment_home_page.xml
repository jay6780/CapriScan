<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg3">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary">
            <TextView
                android:id="@+id/homeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginVertical="8dp" />
            <ImageView
                android:id="@+id/logo"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:src="@drawable/official_logo"
                android:contentDescription="App Logo"
                android:padding="4dp"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Card 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guide on How to Use CapriScan"
                            android:textSize="27sp"
                            android:textStyle="bold"
                            android:textColor="#8DB600" />
                    </LinearLayout>

                    <!-- Divider Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#8DB600" /> <!-- Set the color of the line -->

                    <!-- Expanded Content Section -->
                    <LinearLayout
                        android:id="@+id/expanded_content_1"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome to CapriScan, your go-to app for diagnosing goat diseases quickly and efficiently! Here’s how you can get started:\n\n
1. Register or Log In:\nStart by signing up with your email. If you already have an account, simply log in to access all features.\n\n
2. Choose Detection Area:\nBefore scanning, select the specific area to diagnose: Head, Skin, Knee, Hoof, or Stool. This ensures accurate analysis based on the selected region.\n\n
3. Scan for Diseases:\nNavigate to the chosen detection page. You can either upload a picture of the infected area or take a new one. The app will then analyze the image using advanced image processing to detect potential diseases.\n\n
4. Review First Aid Suggestions:\nOnce a disease is identified, CapriScan will provide first aid steps you can follow to manage the condition before seeking veterinary help.\n\n
5. Find a Vet:\nUse the 'Find a Vet' feature to locate nearby veterinarians based on your current location for professional assistance.\n\n
6. Join the Community:\nConnect with other goat farmers, share experiences, ask questions, and learn from others in the community forum.\n\n
7. Stay Updated:\nCheck out the 'Admin Page' for the latest updates, news, and improvements to the app."
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="How CapriScan Works"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="#8DB600" />
                    </LinearLayout>

                    <!-- Divider Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#8DB600" /> <!-- Set the color of the line -->

                    <!-- Expanded Content Section -->
                    <LinearLayout
                        android:id="@+id/expanded_content_2"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Capture or Upload: Take a photo or upload an image of your goat.\n\n
Analyze: CapriScan processes the image and compares it to a disease database.\n\n
Get Results: The app identifies the likely disease and provides first aid information.\n\n
Take Action: Use the provided first aid guidance or click 'Find a Vet' for professional assistance."
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <!-- Card 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Goats and Their Benefits"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="#8DB600" />
                    </LinearLayout>

                    <!-- Divider Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#8DB600" /> <!-- Set the color of the line -->

                    <!-- Expanded Content Section -->
                    <LinearLayout
                        android:id="@+id/expanded_content_3"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Goats are domesticated animals that are known for being intelligent, agile, and adaptable. They are raised for a variety of reasons, providing numerous benefits. One of the main benefits of goats is their milk, which is easier to digest than cow's milk and is rich in nutrients like calcium and vitamins. Goat meat, also called chevon, is a healthy source of protein that is lean and low in fat, making it a popular choice for people seeking healthier meat options. Certain goat breeds, like Angora and Cashmere goats, produce high-quality fibers used to make soft, warm textiles. Goats also help with land management because they eat weeds and shrubs, helping to clear land naturally. Their manure is an excellent fertilizer, enriching the soil and promoting plant growth. Goats are social animals and can make great pets, as they are friendly and playful. They are also easy to care for, needing less space than other livestock, and are hardy animals that can thrive in different climates."
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Common Diseases of Goats"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="#8DB600" />
                    </LinearLayout>

                    <!-- Divider Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#8DB600" /> <!-- Set the color of the line -->

                    <!-- Expanded Content Section -->
                    <LinearLayout
                        android:id="@+id/expanded_content_4"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caprine Arthritis Encephalitis (CAE): A viral disease that affects goats, causing arthritis (joint inflammation) and in some cases, neurological problems like weakness or paralysis.\n\n
Nose Discharge: A common symptom in goats that may indicate respiratory infections or other underlying health issues.\n\n
Orf: A viral infection that causes sores and scabs, typically around the mouth, nose, and udder. It's contagious to humans and other animals.\n\n
Pink Eye: An infection of the eye that causes redness, swelling, and discharge. It can make the goat's eyes sensitive to light.\n\n
Ringworm: A fungal infection that causes circular, hairless patches on the goat's skin. It's highly contagious but not harmful in the long term.\n\n
Foot Rot: A painful infection in the hooves caused by bacteria, leading to lameness and difficulty walking.\n\n
Diarrhea: Loose, watery stool that can be caused by various factors like infections, parasites, or poor diet. If untreated, it can lead to dehydration."
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card 5 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="4dp"
                app:cardCornerRadius="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Title Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Using CapriScan for Goat Health"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:textColor="#8DB600" />
                    </LinearLayout>

                    <!-- Divider Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#8DB600" /> <!-- Set the color of the line -->

                    <!-- Expanded Content Section -->
                    <LinearLayout
                        android:id="@+id/expanded_content_5"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="To use CapriScan, open the app and navigate to the Scan section. You can either upload an image of the affected area or take a picture using your phone’s camera. Please note that CapriScan only works on the external body of the goat and cannot detect diseases that are inside the body. Once the image is processed, the app will identify any external diseases and provide relevant first aid advice. CapriScan also guides you on the next steps, including suggesting nearby veterinary clinics if needed."
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>